{
  "name": "windows-copy-paste-mode",
  "displayName": "Windows Copy Paste Mode",
  "description": "Cursor / VS Code のコピー＆ペーストを、初心者でもワンクリックで Windows アプリに近い感覚へ。書式なしコピペ・ターミナル安全貼り付け・クリップボード画像のターミナル挿入・スイッチ式設定UI・おすすめ設定をまとめて提供（外部送信なし）。",
  "version": "0.3.0",
  "publisher": "deskflowlabs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/deskflowlabs/windows-copy-paste-mode.git"
  },
  "bugs": {
    "url": "https://github.com/deskflowlabs/windows-copy-paste-mode/issues"
  },
  "homepage": "https://github.com/deskflowlabs/windows-copy-paste-mode#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "copy",
    "paste",
    "clipboard",
    "windows",
    "beginner",
    "cursor",
    "image",
    "screenshot",
    "terminal"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "windowsCopyPaste.applyRecommendedSettings",
        "title": "%command.applyRecommendedSettings.title%",
        "category": "Windows Copy Paste Mode"
      },
      {
        "command": "windowsCopyPaste.restorePreviousSettings",
        "title": "%command.restorePreviousSettings.title%",
        "category": "Windows Copy Paste Mode"
      },
      {
        "command": "windowsCopyPaste.copyPlainText",
        "title": "%command.copyPlainText.title%",
        "category": "Windows Copy Paste Mode"
      },
      {
        "command": "windowsCopyPaste.pastePlainText",
        "title": "%command.pastePlainText.title%",
        "category": "Windows Copy Paste Mode"
      },
      {
        "command": "windowsCopyPaste.safePasteToTerminal",
        "title": "%command.safePasteToTerminal.title%",
        "category": "Windows Copy Paste Mode"
      },
      {
        "command": "windowsCopyPaste.pasteImageToTerminal",
        "title": "%command.pasteImageToTerminal.title%",
        "category": "Windows Copy Paste Mode"
      },
      {
        "command": "windowsCopyPaste.openSettings",
        "title": "%command.openSettings.title%",
        "category": "Windows Copy Paste Mode"
      }
    ],
    "keybindings": [
      {
        "command": "windowsCopyPaste.copyPlainText",
        "key": "ctrl+alt+c",
        "when": "editorTextFocus"
      },
      {
        "command": "windowsCopyPaste.pastePlainText",
        "key": "ctrl+alt+v",
        "when": "editorTextFocus"
      },
      {
        "command": "windowsCopyPaste.safePasteToTerminal",
        "key": "ctrl+alt+shift+v",
        "when": "terminalFocus"
      },
      {
        "command": "windowsCopyPaste.pasteImageToTerminal",
        "key": "ctrl+alt+shift+i"
      }
    ],
    "configuration": {
      "title": "Windows Copy Paste Mode",
      "properties": {
        "windowsCopyPaste.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.enabled.description%"
        },
        "windowsCopyPaste.showOnboarding": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.showOnboarding.description%"
        },
        "windowsCopyPaste.backupSettings": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.backupSettings.description%"
        },
        "windowsCopyPaste.confirmMultiLineTerminalPaste": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.confirmMultiLineTerminalPaste.description%"
        },
        "windowsCopyPaste.multiLinePreviewMaxLines": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 20,
          "markdownDescription": "%config.multiLinePreviewMaxLines.description%"
        },
        "windowsCopyPaste.language": {
          "type": "string",
          "enum": [
            "auto",
            "ja",
            "en",
            "zh-cn",
            "zh-tw",
            "ko",
            "es",
            "fr"
          ],
          "default": "auto",
          "markdownDescription": "%config.language.description%"
        },
        "windowsCopyPaste.features.settings": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.features.settings.description%"
        },
        "windowsCopyPaste.features.copyPlainText": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.features.copyPlainText.description%"
        },
        "windowsCopyPaste.features.pastePlainText": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.features.pastePlainText.description%"
        },
        "windowsCopyPaste.features.safePasteToTerminal": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.features.safePasteToTerminal.description%"
        },
        "windowsCopyPaste.features.terminalImagePaste": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.features.terminalImagePaste.description%"
        },
        "windowsCopyPaste.terminalImagePaste.saveDirectory": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.terminalImagePaste.saveDirectory.description%"
        },
        "windowsCopyPaste.terminalImagePaste.fileNamePattern": {
          "type": "string",
          "default": "shot-YYYYMMDD-HHmmss.png",
          "markdownDescription": "%config.terminalImagePaste.fileNamePattern.description%"
        },
        "windowsCopyPaste.terminalImagePaste.appendTrailingSpace": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.terminalImagePaste.appendTrailingSpace.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "tsc --noEmit -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "typescript": "^5.4.0"
  }
}
